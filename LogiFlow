<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Logistik - Systém Závozů</title>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #0f172a; color: #f8fafc; padding: 10px; font-size: 14px; }
        
        #loginScreen {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            min-height: 80vh; text-align: center; padding: 20px;
        }
        .login-box {
            background: #1e293b; border: 1px solid #334155; padding: 24px;
            border-radius: 12px; width: 100%; max-width: 340px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        .login-title { font-size: 1.4rem; font-weight: bold; color: #f59e0b; margin-bottom: 6px; }
        .login-sub { font-size: 0.8rem; color: #94a3b8; margin-bottom: 16px; }
        
        .login-mode-select { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 14px; }
        .login-mode-btn { padding: 10px 4px; font-size: 0.85rem; font-weight: bold; border-radius: 6px; cursor: pointer; border: 2px solid #334155; background: #1e293b; color: #94a3b8; text-align: center; }
        .login-mode-btn.active-a { background: #1e3a8a; border-color: #3b82f6; color: #fff; }
        .login-mode-btn.active-b { background: #581c87; border-color: #a855f7; color: #fff; }

        .login-input {
            width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155;
            border-radius: 8px; color: #fff; font-size: 1.2rem; text-align: center;
            letter-spacing: 4px; margin-bottom: 12px; outline: none;
        }
        .login-input:focus { border-color: #f59e0b; }
        .btn-login {
            width: 100%; padding: 12px; background: #f59e0b; color: #0f172a;
            border: none; border-radius: 8px; font-size: 1rem; font-weight: bold; cursor: pointer;
        }
        .login-error { color: #ef4444; font-size: 0.8rem; margin-top: 10px; display: none; }

        #appScreen { display: none; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .logo { font-size: 1.1rem; font-weight: bold; color: #f59e0b; }
        
        .header-right { display: flex; align-items: center; gap: 6px; }
        .role-badge { font-size: 0.75rem; padding: 5px 10px; border-radius: 6px; font-weight: bold; background: #1e3a8a; color: #3b82f6; }
        .role-badge.b { background: #581c87; color: #a855f7; }
        .btn-logout { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid #ef4444; padding: 5px 8px; font-size: 0.75rem; border-radius: 6px; cursor: pointer; font-weight: bold; }
        .btn-settings { background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid #f59e0b; padding: 5px 8px; font-size: 0.75rem; border-radius: 6px; cursor: pointer; font-weight: bold; }

        .line-select { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
        .line-btn { padding: 10px 6px; background: #1e293b; border: 2px solid #334155; color: #94a3b8; font-weight: bold; text-align: center; border-radius: 8px; cursor: pointer; font-size: 0.75rem; line-height: 1.3; }
        
        .line-btn.active-1 { border-color: #3b82f6; color: #fff; background: #1e3a8a; }
        .line-btn.active-2 { border-color: #a855f7; color: #fff; background: #581c87; }

        .lbl { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; font-weight: bold; margin: 8px 0 4px 0; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 8px; }
        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-bottom: 8px; }
        .btn-opt { background: #1e293b; border: 1px solid #334155; color: #fff; padding: 10px 4px; border-radius: 8px; font-weight: bold; text-align: center; cursor: pointer; font-size: 0.85rem; }
        
        .btn-opt.selected-1 { border-color: #3b82f6; background: rgba(59, 130, 246, 0.25); color: #fff; }
        .btn-opt.selected-2 { border-color: #a855f7; background: rgba(168, 85, 247, 0.25); color: #fff; }

        .single-mode-panel { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 10px; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .single-mode-panel.line-1 { border-color: #3b82f6; }
        .single-mode-panel.line-2 { border-color: #a855f7; }
        .single-mode-txt { font-size: 0.8rem; font-weight: bold; color: #f8fafc; }

        .mode-selector-box { background: #1e293b; border: 1px dashed #334155; border-radius: 8px; padding: 8px; margin-bottom: 10px; display: none; }
        .mode-selector-box.active { display: block; }
        .mode-selector-box.line-1 { border-color: #3b82f6; }
        .mode-selector-box.line-2 { border-color: #a855f7; }

        /* PANEL PRO OPAKOVÁNÍ ZAVEZENÍ / BEDNA NENÍ NA ČIDLE */
        .repeat-panel { background: #1e293b; border: 1px solid #f59e0b; border-radius: 8px; padding: 10px; margin-bottom: 10px; }
        .repeat-title { font-size: 0.8rem; font-weight: bold; color: #f59e0b; text-align: center; margin-bottom: 8px; }
        .box-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; text-align: center; }
        .box-col { background: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 6px 2px; }
        .box-col-lbl { font-size: 0.7rem; color: #94a3b8; font-weight: bold; margin-bottom: 4px; }
        .box-col-btn { width: 100%; padding: 6px 2px; font-size: 0.75rem; font-weight: bold; border-radius: 4px; border: 1px solid #334155; background: #1e293b; color: #64748b; cursor: pointer; }
        .box-col-btn.active { background: #ef4444; color: #fff; border-color: #ef4444; animation: pulseAlarm 1.5s infinite; }

        @keyframes pulseAlarm {
            0% { opacity: 1; }
            50% { opacity: 0.6; }
            100% { opacity: 1; }
        }

        /* VZV UPOZORNĚNÍ NA CHYBĚJÍCÍ BEDNU NA ČIDLE */
        .vzv-sensor-alert { background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; border-radius: 8px; padding: 10px; margin-bottom: 10px; text-align: center; animation: pulseAlarm 1.5s infinite; }
        .vzv-sensor-title { font-size: 0.85rem; font-weight: bold; color: #ef4444; margin-bottom: 6px; text-transform: uppercase; }
        .btn-resolve-sensor { background: #ef4444; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; font-size: 0.75rem; cursor: pointer; margin-top: 4px; }

        .custom-stojan-input { margin-top: 6px; display: none; gap: 6px; align-items: center; }
        .custom-stojan-input.active { display: flex; }
        .custom-stojan-input input { background: #1e293b; border: 1px solid #334155; color: #fff; padding: 8px; border-radius: 6px; font-size: 0.9rem; width: 100%; font-weight: bold; }
        .custom-stojan-input.line-1 input { border-color: #3b82f6; }
        .custom-stojan-input.line-2 input { border-color: #a855f7; }

        .note-input { width: 100%; background: #1e293b; border: 1px solid #334155; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; outline: none; }
        .note-input:focus { border-color: #f59e0b; }

        .box-info { background: #1e293b; border: 1px dashed #334155; border-radius: 8px; padding: 8px; display: flex; justify-content: space-around; text-align: center; margin-bottom: 12px; }
        .val { font-size: 1.1rem; font-weight: bold; color: #f59e0b; }
        .btn-submit { width: 100%; padding: 12px; background: #f59e0b; color: #0f172a; border: none; border-radius: 8px; font-size: 1rem; font-weight: bold; cursor: pointer; }

        .vzv-card { background: #1e293b; border-radius: 8px; padding: 10px; margin-bottom: 10px; border-top: 4px solid #a855f7; }
        .vzv-card.l1-card { border-top-color: #3b82f6; }
        .vzv-hdr { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
        .badge { font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; color: #fff; font-weight: bold; background: #3b82f6; }
        .badge.l2 { background: #a855f7; }
        .next-txt { font-size: 0.8rem; color: #f59e0b; font-weight: bold; margin-top: 2px; line-height: 1.3; }
        .next-txt.none { color: #64748b; font-weight: normal; }
        
        .boxes-row { display: flex; gap: 4px; margin: 8px 0; flex-wrap: wrap; }
        .box-unit { flex: 1; min-width: 30px; height: 26px; background: #0f172a; border: 1px solid #334155; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: #64748b; font-weight: bold; }
        
        .box-unit.done { background: #065f46; color: #34d399; border-color: #059669; }
        .box-unit.pending { background: rgba(239, 68, 68, 0.25); color: #f87171; border-color: #ef4444; }
        .box-unit.active { background: #0f172a; color: #f8fafc; border-color: #334155; }

        .btn-zavez { width: 100%; padding: 10px; background: #10b981; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }

        /* MODAL NASTAVENÍ */
        #settingsModal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.85); z-index: 1000; align-items: center; justify-content: center; padding: 15px;
        }
        .settings-box {
            background: #1e293b; border: 2px solid #f59e0b; border-radius: 12px;
            width: 100%; max-width: 360px; padding: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            max-height: 90vh; overflow-y: auto;
        }
        .settings-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .settings-title { font-size: 1.1rem; font-weight: bold; color: #f59e0b; }
        .btn-close { background: transparent; border: none; color: #94a3b8; font-size: 1.2rem; font-weight: bold; cursor: pointer; }

        .settings-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: #0f172a; padding: 10px; border-radius: 8px; }

        .banner-btns { display: flex; gap: 4px; background: #0f172a; padding: 3px; border-radius: 6px; }
        .btn-yn { padding: 5px 12px; border-radius: 4px; font-weight: bold; font-size: 0.75rem; border: none; cursor: pointer; color: #64748b; background: transparent; }
        .btn-yn.active-yes { background: #10b981; color: #fff; }
        .btn-yn.active-no { background: #ef4444; color: #fff; }

        /* VLASTNÍ OKNO PRO HESLO SPRÁVCE */
        #adminPasswordModal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.85); z-index: 10000; align-items: center; justify-content: center; padding: 15px;
        }
        .admin-pwd-box {
            background: #1e293b; border: 2px solid #f59e0b; border-radius: 12px;
            width: 100%; max-width: 320px; padding: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        }
        .admin-pwd-input {
            width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155;
            border-radius: 8px; color: #fff; font-size: 1.2rem; text-align: center;
            letter-spacing: 4px; margin: 15px 0; outline: none;
        }
        .admin-pwd-input:focus { border-color: #f59e0b; }
        .admin-pwd-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .btn-admin-action { padding: 10px; border-radius: 6px; font-weight: bold; border: none; cursor: pointer; font-size: 0.9rem; }
        .btn-admin-cancel { background: #334155; color: #94a3b8; }
        .btn-admin-ok { background: #f59e0b; color: #0f172a; }

        /* PŘEKRYVNÉ BANNERY - KLIKNUTÍM NA NADPIS SE PŘIHLÁSÍ SPRÁVCE */
        #updateBannerOverlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.95); z-index: 9999; align-items: center; justify-content: center; padding: 20px; text-align: center;
        }
        .update-banner-box {
            background: #1e293b; border: 3px solid #ef4444; border-radius: 16px;
            width: 100%; max-width: 380px; padding: 28px 24px; box-shadow: 0 15px 40px rgba(239, 68, 68, 0.4);
        }
        .update-banner-title { font-size: 1.2rem; font-weight: bold; color: #ef4444; margin-bottom: 16px; text-transform: uppercase; cursor: pointer; user-select: none; }
        .update-banner-text { font-size: 1rem; color: #f8fafc; font-weight: bold; line-height: 1.5; }

        .update-banner-box.completed-box {
            border: 3px solid #10b981;
            box-shadow: 0 15px 40px rgba(16, 185, 129, 0.4);
        }
        .update-banner-box.completed-box .update-banner-title {
            color: #10b981;
        }

        .vzv-alert-panel { background: #1e293b; border: 1px solid #ef4444; border-radius: 8px; padding: 10px; margin-top: 16px; }
        .vzv-alert-title { font-size: 0.8rem; font-weight: bold; color: #ef4444; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; gap: 4px; }
        .vzv-alert-row { display: flex; gap: 6px; margin-bottom: 8px; }
        .vzv-select { flex: 1; background: #0f172a; border: 1px solid #334155; color: #fff; padding: 8px; border-radius: 6px; font-size: 0.85rem; font-weight: bold; outline: none; }
        .vzv-num-input { width: 140px; background: #0f172a; border: 1px solid #334155; color: #fff; padding: 8px; border-radius: 6px; font-size: 0.75rem; text-align: center; font-weight: bold; outline: none; }
        .btn-send-alert { width: 100%; padding: 9px; background: #ef4444; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.85rem; }

        .empty { text-align: center; color: #64748b; padding: 12px; font-size: 0.85rem; }
        .done-msg { background: #065f46; color: #34d399; padding: 10px; border-radius: 8px; text-align: center; font-weight: bold; margin-top: 10px; }
        
        .note-tag { padding: 4px 8px; font-size: 0.75rem; margin: 4px 0 8px 0; border-radius: 0 4px 4px 0; }
        .note-tag.line-1 { background: rgba(59, 130, 246, 0.15); border-left: 3px solid #3b82f6; color: #93c5fd; }
        .note-tag.line-2 { background: rgba(168, 85, 247, 0.15); border-left: 3px solid #a855f7; color: #d8b4fe; }

        .vzv-single-mode-box { background: rgba(245, 158, 11, 0.15); border: 1px solid #f59e0b; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.75rem; color: #fbbf24; font-weight: bold; text-align: center; line-height: 1.4; }

        .btn-delete { background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #ef4444; width: 26px; height: 26px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.85rem; cursor: pointer; margin-left: 8px; flex-shrink: 0; }
        .stock-alert-box { background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.80rem; display: flex; justify-content: space-between; align-items: center; gap: 6px; }
        .btn-dismiss { background: #ef4444; color: #fff; border: none; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; cursor: pointer; white-space: nowrap; }
        
        .wrt-badge-1 { background: rgba(59, 130, 246, 0.25); border: 1px solid #3b82f6; color: #93c5fd; font-weight: bold; font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; white-space: nowrap; }
        .wrt-badge-2 { background: rgba(168, 85, 247, 0.25); border: 1px solid #a855f7; color: #d8b4fe; font-weight: bold; font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; white-space: nowrap; }
        
        .editable-progress {
            color: #f59e0b; font-weight: bold; white-space: nowrap; margin-left: 8px;
            background: rgba(245, 158, 11, 0.15); padding: 4px 8px; border-radius: 6px; cursor: pointer;
            border: 1px dashed #f59e0b;
        }
    </style>
</head>
<body>

    <!-- PŘEKRYVNÝ BANNER PRO ÚDRŽBU (KLIKNUTÍM NA NADPIS SE MŮŽE PŘIHLÁSIT SPRÁVCE) -->
    <div id="updateBannerOverlay">
        <div class="update-banner-box" id="updateBannerBox">
            <div class="update-banner-title" id="bannerTitle" onclick="openAdminPasswordModal(true)" title="Kliknutím zadat heslo správce">⚠️ UPOZORNĚNÍ NA ÚDRŽBU</div>
            <div class="update-banner-text" id="bannerText">POZOR: Proběhne aktualizace programu připravte se na výpadek.<br><br>Neřiďte se PROGRAMEM !!!</div>
        </div>
    </div>

    <!-- VLASTNÍ OKNO PRO HESLO SPRÁVCE -->
    <div id="adminPasswordModal">
        <div class="admin-pwd-box">
            <div style="font-size: 1rem; font-weight: bold; color: #f59e0b;">🔒 Zadejte heslo správce</div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 4px;">Pro přístup nebo změnu režimu</div>
            <input type="password" id="adminPassInput" class="admin-pwd-input" placeholder="••••••" autofocus onkeydown="if(event.key==='Enter') verifyAdminPassword()">
            <div id="adminPassError" style="color: #ef4444; font-size: 0.75rem; margin-bottom: 8px; display: none;">⚠️ Nesprávné heslo!</div>
            <div class="admin-pwd-btns">
                <button class="btn-admin-action btn-admin-cancel" onclick="closeAdminPasswordModal()">Zrušit</button>
                <button class="btn-admin-action btn-admin-ok" onclick="verifyAdminPassword()">Potvrdit</button>
            </div>
        </div>
    </div>

    <div id="loginScreen">
        <div class="login-box">
            <div class="login-title">⚡ LogiFlow</div>
            <div class="login-sub">Zvolte roli a zadejte heslo</div>
            
            <div class="login-mode-select">
                <button type="button" id="loginBtnA" class="login-mode-btn active-a" onclick="setLoginMode('A')">Obsluha A</button>
                <button type="button" id="loginBtnB" class="login-mode-btn" onclick="setLoginMode('B')">VZV B</button>
            </div>

            <input type="password" id="passInput" class="login-input" placeholder="••••" autofocus onkeydown="if(event.key==='Enter') checkPassword()">
            <button class="btn-login" type="button" onclick="checkPassword()">VSTOUPIT DO SYSTÉMU</button>
            <div id="loginError" class="login-error">⚠️ Nesprávné heslo! Zkuste to znovu.</div>
        </div>
    </div>

    <div id="appScreen">
        <div class="header">
            <div class="logo">⚡ LogiFlow</div>
            <div class="header-right">
                <button class="btn-settings" onclick="openSettingsModal()" title="Nastavení">⚙️ Nastavení</button>
                <span id="roleBadge" class="role-badge">Obsluha A</span>
                <button class="btn-logout" onclick="logout()" title="Odhlásit tento telefon">🔓 Odhlásit</button>
            </div>
        </div>

        <div id="viewA">
            <div id="alertAreaA"></div>
            <div class="lbl">Vyberte Linku</div>
            <div class="line-select">
                <div class="line-btn active-1" id="lBtn1" onclick="setLine(1)">LINKA 1<br><span style="font-size:0.65rem; font-weight:normal;">BOX 4 - 3</span></div>
                <div class="line-btn" id="lBtn2" onclick="setLine(2)">LINKA 2<br><span style="font-size:0.65rem; font-weight:normal;">BOX 2 - 1</span></div>
            </div>

            <div class="single-mode-panel line-1" id="singleModePanel">
                <div class="single-mode-txt">🔒 Režim: Jede pouze 1 varianta</div>
                <div class="banner-btns">
                    <button class="btn-yn" id="btnSingleYes" onclick="toggleSingleMode(true)">ZAP</button>
                    <button class="btn-yn active-no" id="btnSingleNo" onclick="toggleSingleMode(false)">VYP</button>
                </div>
            </div>

            <div class="mode-selector-box line-1" id="singleModeSelectBox">
                <div class="lbl" style="margin-top:0;">Vyberte variantu pro režim:</div>
                <div class="grid-3" id="singleCarGrid" style="margin-bottom:0;">
                    <div class="btn-opt" onclick="setSingleCar('Tiguan', this)">Tiguan</div>
                    <div class="btn-opt" onclick="setSingleCar('Kodiaq', this)">Kodiaq</div>
                    <div class="btn-opt" onclick="setSingleCar('Tayron', this)">Tayron</div>
                    <div class="btn-opt" onclick="setSingleCar('Audi', this)">Audi</div>
                    <div class="btn-opt" onclick="setSingleCar('Seat', this)">Seat</div>
                </div>
            </div>

            <div class="single-mode-panel line-1" id="twoVariantPanel">
                <div class="single-mode-txt">🔒 Režim: Jedou 2 varianty (stejný obal)</div>
                <div class="banner-btns">
                    <button class="btn-yn" id="btnTwoYes" onclick="toggleTwoVariantMode(true)">ZAP</button>
                    <button class="btn-yn active-no" id="btnTwoNo" onclick="toggleTwoVariantMode(false)">VYP</button>
                </div>
            </div>

            <div class="mode-selector-box line-1" id="twoModeSelectBox">
                <div class="lbl" style="margin-top:0;">Vyberte dvojici variant pro kontrolu:</div>
                <div class="grid-2" id="twoPairGrid" style="margin-bottom:0;">
                    <div class="btn-opt" onclick="setTwoPair('Tiguan / Kodiaq', this)">Tiguan / Kodiaq</div>
                    <div class="btn-opt" onclick="setTwoPair('Audi / Seat', this)">Audi / Seat</div>
                </div>
            </div>

            <!-- PANEL: OPAKUJ ZAVEZENÍ, BEDNA NENÍ NA ČIDLE (BOX 4, 3, 2, 1) -->
            <div class="repeat-panel">
                <div class="repeat-title">Opakuj zavezení, bedna není na čidle</div>
                <div class="box-grid-4">
                    <div class="box-col">
                        <div class="box-col-lbl">Box 4</div>
                        <button class="box-col-btn" id="repeatBox4" onclick="toggleRepeatBox(4)">VYP</button>
                    </div>
                    <div class="box-col">
                        <div class="box-col-lbl">Box 3</div>
                        <button class="box-col-btn" id="repeatBox3" onclick="toggleRepeatBox(3)">VYP</button>
                    </div>
                    <div class="box-col">
                        <div class="box-col-lbl">Box 2</div>
                        <button class="box-col-btn" id="repeatBox2" onclick="toggleRepeatBox(2)">VYP</button>
                    </div>
                    <div class="box-col">
                        <div class="box-col-lbl">Box 1</div>
                        <button class="box-col-btn" id="repeatBox1" onclick="toggleRepeatBox(1)">VYP</button>
                    </div>
                </div>
            </div>

            <div id="standardOrderSection">
                <div class="lbl" id="productLbl">Produkt</div>
                <div class="grid-3" id="carGrid">
                    <div class="btn-opt selected-1" onclick="setCar('Tiguan', this)">Tiguan</div>
                    <div class="btn-opt" onclick="setCar('Kodiaq', this)">Kodiaq</div>
                    <div class="btn-opt" onclick="setCar('Tayron', this)">Tayron</div>
                    <div class="btn-opt" onclick="setCar('Audi', this)">Audi</div>
                    <div class="btn-opt" onclick="setCar('Seat', this)">Seat</div>
                </div>

                <div class="lbl">Počet Stojanů WRT</div>
                <div class="grid-3" id="stojanGrid">
                    <div class="btn-opt selected-1" id="opt3WRT" onclick="setStojany(3, this)">3 WRT</div>
                    <div class="btn-opt" id="opt6WRT" onclick="setStojany(6, this)">6 WRT</div>
                    <div class="btn-opt" id="optCustomWRT" onclick="enableCustomStojany(this)">✏️ Vlastní</div>
                </div>

                <div class="custom-stojan-input line-1" id="customStojanBox">
                    <span style="font-size:0.8rem; color:#94a3b8; white-space:nowrap;">Zadejte počet:</span>
                    <input type="number" id="customInput" min="1" max="50" value="4" oninput="onCustomStojanyInput(this.value)">
                </div>

                <div class="lbl">Poznámka pro VZV (volitelné)</div>
                <input type="text" id="noteInput" class="note-input" placeholder="Napište poznámku k objednávce..." />

                <div class="box-info">
                    <div><div class="val" id="lblKs">36 ks</div><div style="font-size:0.65rem; color:#94a3b8;">CELKEM</div></div>
                    <div><div class="val" id="lblOb">4 obaly</div><div style="font-size:0.65rem; color:#94a3b8;">K ZAVÁŽENÍ (po 9ks)</div></div>
                </div>

                <button class="btn-submit" onclick="addOrder()">POSLAT OBJEDNÁVKU VZV</button>
            </div>

            <div class="lbl" style="margin-top:16px;">Odesláno na VZV (Probíhají objednávky / Aktivní režimy)</div>
            <div id="listA"></div>
        </div>

        <div id="viewB" style="display:none;">
            <div class="lbl">Přehled linek</div>
             
            <!-- VZV UPOZORNĚNÍ PRO CHYBĚJÍCÍ BEDNY NA ČIDLECH -->
            <div id="vzvSensorAlertArea"></div>

            <div class="vzv-card l2">
                <div class="vzv-hdr">
                    <div>
                        <span class="badge l2">Box: 1 - 2</span>
                        <h2 id="l2Title" style="font-size:1.1rem; margin-top:2px;">-</h2>
                        <div id="l2Next" class="next-txt none">Následuje ➔ Žádné</div>
                    </div>
                </div>
                <div id="l2Body"></div>
            </div>
            
            <div class="vzv-card l1-card">
                <div class="vzv-hdr">
                    <div>
                        <span class="badge">Box: 3 - 4</span>
                        <h2 id="l1Title" style="font-size:1.1rem; margin-top:2px;">-</h2>
                        <div id="l1Next" class="next-txt none">Následuje ➔ Žádné</div>
                    </div>
                </div>
                <div id="l1Body"></div>
            </div>

            <div class="vzv-alert-panel">
                <div class="vzv-alert-title">⚠️ Hlášení stavu obalů obsluze A</div>
                <div class="vzv-alert-row">
                    <select id="vzvVariantSelect" class="vzv-select">
                        <option value="Tiguan / Kodiaq">Tiguan / Kodiaq</option>
                        <option value="Audi / Seat">Audi / Seat</option>
                        <option value="Tayron">Tayron</option>
                    </select>
                    <input type="number" id="vzvCountInput" class="vzv-num-input" placeholder="zde napiš počet obalu" value="" min="1" max="99">
                </div>
                <button class="btn-send-alert" onclick="sendCustomStockAlert()">📢 ODESLAT HLÁŠENÍ OBSLUZE A</button>
            </div>

            <div id="doneBanner" class="done-msg" style="display:none;">
                ✓ Vše zpracováno! Čekám na novou objednávku.
            </div>
        </div>
    </div>

    <!-- MODAL NASTAVENÍ -->
    <div id="settingsModal">
        <div class="settings-box">
            <div class="settings-header">
                <div class="settings-title">⚙️ Nastavení systému</div>
                <button class="btn-close" onclick="closeSettingsModal()">✕</button>
            </div>

            <div class="settings-row">
                <span style="font-size:0.85rem; font-weight:bold;">🔔 Zvukové notifikace</span>
                <div class="banner-btns">
                    <button class="btn-yn active-yes" id="setNotifYes" onclick="toggleNotifications(true)">ANO</button>
                    <button class="btn-yn" id="setNotifNo" onclick="toggleNotifications(false)">NE</button>
                </div>
            </div>

            <div style="background:#0f172a; padding:12px; border-radius:8px; margin-top:12px; border:1px solid #ef4444;">
                <div style="font-size:0.85rem; font-weight:bold; color:#ef4444; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                    <span>🔒</span> Režim údržby / Aktualizace
                </div>
                <div style="font-size:0.75rem; color:#94a3b8; margin-bottom:8px;">Aktivuje výstrahu na všech zařízeních A i B. Vyžaduje heslo správce.</div>
                <div class="banner-btns" style="width:100%; display:grid; grid-template-columns:1fr 1fr;">
                    <button class="btn-yn" id="setUpdateYes" onclick="openAdminPasswordModal(true)">ZAPNOUT</button>
                    <button class="btn-yn active-no" id="setUpdateNo" onclick="openAdminPasswordModal(false)">VYPNOUT</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const firebaseConfig = {
            databaseURL: "https://logiflow-app-default-rtdb.europe-west1.firebasedatabase.app"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        const SYSTEM_PASSWORD = '1234';
        const ADMIN_PASSWORD = '704517';
        let notificationsEnabled = true;
        let curLine = 1, curCar = 'Tiguan', curStojany = 3;
        let singleModeLines = { 1: false, 2: false };
        let singleModeCar = { 1: 'Tiguan', 2: 'Tiguan' };
        let twoVariantModeLines = { 1: false, 2: false };
        let twoVariantPair = { 1: 'Tiguan / Kodiaq', 2: 'Tiguan / Kodiaq' };
        let repeatBoxes = { 1: false, 2: false, 3: false, 4: false };
        
        let systemUpdateActive = false;
        let systemUpdateCompletedState = false;
        let pendingUpdateState = false;
        let adminBypassed = false; // Příznak, zda se správce dočasně prokliknul ven

        let orders = [];
        let stockAlerts = [];
        let lastOrderCount = 0;
        let selectedLoginMode = 'A';

        db.ref('orders').on('value', (snapshot) => {
            let rawOrders = snapshot.val() || [];
            let updatedOrders = Array.isArray(rawOrders) ? rawOrders : Object.values(rawOrders);
            if (updatedOrders.length > lastOrderCount) {
                let newest = updatedOrders[updatedOrders.length - 1];
                triggerNotification("⚡ Nová objednávka na VZV!", `${newest.car} (${newest.stojany} WRT) - Linka ${newest.line}`);
            }
            orders = updatedOrders;
            lastOrderCount = orders.length;
            render();
        });

        db.ref('alerts').on('value', (snapshot) => {
            let rawAlerts = snapshot.val() || [];
            stockAlerts = Array.isArray(rawAlerts) ? rawAlerts : Object.values(rawAlerts);
            render();
        });

        db.ref('singleModeLines').on('value', (snapshot) => {
            let data = snapshot.val();
            if (data) singleModeLines = data;
            render();
        });

        db.ref('singleModeCar').on('value', (snapshot) => {
            let data = snapshot.val();
            if (data) singleModeCar = data;
            render();
        });

        db.ref('twoVariantModeLines').on('value', (snapshot) => {
            let data = snapshot.val();
            if (data) twoVariantModeLines = data;
            render();
        });

        db.ref('twoVariantPair').on('value', (snapshot) => {
            let data = snapshot.val();
            if (data) twoVariantPair = data;
            render();
        });

        db.ref('repeatBoxes').on('value', (snapshot) => {
            let data = snapshot.val();
            if (data) repeatBoxes = data;
            render();
        });

        db.ref('systemUpdate').on('value', (snapshot) => {
            let val = snapshot.val();
            let newActive = val ? val.active : false;
            let newCompleted = val ? val.completed : false;

            if (newActive !== systemUpdateActive) {
                adminBypassed = false; // Reset při změně stavu ze serveru
            }

            systemUpdateActive = newActive;
            systemUpdateCompletedState = newCompleted;
            renderUpdateOverlay();
        });

        function save() {
            db.ref('orders').set(orders);
            db.ref('alerts').set(stockAlerts);
            db.ref('singleModeLines').set(singleModeLines);
            db.ref('singleModeCar').set(singleModeCar);
            db.ref('twoVariantModeLines').set(twoVariantModeLines);
            db.ref('twoVariantPair').set(twoVariantPair);
            db.ref('repeatBoxes').set(repeatBoxes);
        }

        function toggleRepeatBox(boxNum) {
            repeatBoxes[boxNum] = !repeatBoxes[boxNum];
            save();
            renderRepeatBoxesUI();
        }

        function renderRepeatBoxesUI() {
            for (let i = 1; i <= 4; i++) {
                let btn = document.getElementById(`repeatBox${i}`);
                if (btn) {
                    if (repeatBoxes[i]) {
                        btn.innerText = "ZAP";
                        btn.className = "box-col-btn active";
                    } else {
                        btn.innerText = "VYP";
                        btn.className = "box-col-btn";
                    }
                }
            }
        }

        function openAdminPasswordModal(enable) {
            pendingUpdateState = enable;
            document.getElementById('adminPassInput').value = '';
            document.getElementById('adminPassError').style.display = 'none';
            document.getElementById('adminPasswordModal').style.display = 'flex';
            setTimeout(() => document.getElementById('adminPassInput').focus(), 100);
        }

        function closeAdminPasswordModal() {
            document.getElementById('adminPasswordModal').style.display = 'none';
        }

        function verifyAdminPassword() {
            let pass = document.getElementById('adminPassInput').value;
            if (pass !== ADMIN_PASSWORD) {
                document.getElementById('adminPassError').style.display = 'block';
                return;
            }
            closeAdminPasswordModal();
            closeSettingsModal();

            // Pokud správce kliknul na nadpis pro nouzový vstup
            if (systemUpdateActive && pendingUpdateState === true && document.getElementById('updateBannerOverlay').style.display === 'flex') {
                adminBypassed = true;
                renderUpdateOverlay();
                return;
            }

            if (pendingUpdateState) {
                db.ref('systemUpdate').set({ active: true, completed: false });
            } else {
                db.ref('systemUpdate').set({ active: false, completed: true });
            }
        }

        function renderUpdateOverlay() {
            let overlay = document.getElementById('updateBannerOverlay');
            let bannerBox = document.getElementById('updateBannerBox');
            let title = document.getElementById('bannerTitle');
            let text = document.getElementById('bannerText');

            if (systemUpdateActive && !adminBypassed) {
                bannerBox.className = "update-banner-box";
                title.innerText = "⚠️ UPOZORNĚNÍ NA ÚDRŽBU";
                text.innerHTML = "POZOR: Proběhne aktualizace programu připravte se na výpadek.<br><br>Neřiďte se PROGRAMEM !!!";
                overlay.style.display = 'flex';
            } else if (systemUpdateCompletedState && !adminBypassed) {
                bannerBox.className = "update-banner-box completed-box";
                title.innerText = "✅ HOTOVO";
                text.innerText = "Program aktualizován, proveďte reset a vymažte objednávky.";
                overlay.style.display = 'flex';
            } else {
                overlay.style.display = 'none';
            }

            let btnYes = document.getElementById('setUpdateYes');
            let btnNo = document.getElementById('setUpdateNo');
            if (btnYes && btnNo) {
                if (systemUpdateActive) {
                    btnYes.className = 'btn-yn active-yes';
                    btnNo.className = 'btn-yn';
                } else {
                    btnYes.className = 'btn-yn';
                    btnNo.className = 'btn-yn active-no';
                }
            }
        }

        function openSettingsModal() {
            document.getElementById('settingsModal').style.display = 'flex';
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').style.display = 'none';
        }

        function setLoginMode(mode) {
            selectedLoginMode = mode;
            const btnA = document.getElementById('loginBtnA');
            const btnB = document.getElementById('loginBtnB');
            if (mode === 'A') {
                btnA.className = 'login-mode-btn active-a';
                btnB.className = 'login-mode-btn';
            } else {
                btnA.className = 'login-mode-btn';
                btnB.className = 'login-mode-btn active-b';
            }
        }

        function checkPassword() {
            const input = document.getElementById('passInput').value;
            if (input === SYSTEM_PASSWORD) {
                sessionStorage.setItem('device_authenticated', 'true');
                sessionStorage.setItem('active_tab', selectedLoginMode);
                document.getElementById('loginError').style.display = 'none';
                showApp();
            } else {
                document.getElementById('loginError').style.display = 'block';
            }
        }

        function logout() {
            sessionStorage.removeItem('device_authenticated');
            sessionStorage.removeItem('active_tab');
            document.getElementById('passInput').value = '';
            document.getElementById('loginError').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'flex';
            document.getElementById('appScreen').style.display = 'none';
        }

        function showApp() {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('appScreen').style.display = 'block';
            
            let savedTab = sessionStorage.getItem('active_tab') || selectedLoginMode || 'A';
            
            document.getElementById('viewA').style.display = savedTab === 'A' ? 'block' : 'none';
            document.getElementById('viewB').style.display = savedTab === 'B' ? 'block' : 'none';

            let badge = document.getElementById('roleBadge');
            if (savedTab === 'A') {
                badge.innerText = 'Obsluha A';
                badge.className = 'role-badge';
            } else {
                badge.innerText = 'VZV B';
                badge.className = 'role-badge b';
            }

            render();
        }

        if (sessionStorage.getItem('device_authenticated') === 'true') {
            showApp();
        }

        function toggleNotifications(enable) {
            notificationsEnabled = enable;
            const setYes = document.getElementById('setNotifYes');
            const setNo = document.getElementById('setNotifNo');

            if (enable) {
                if(setYes) setYes.className = 'btn-yn active-yes';
                if(setNo) setNo.className = 'btn-yn';
            } else {
                if(setYes) setYes.className = 'btn-yn';
                if(setNo) setNo.className = 'btn-yn active-no';
            }
        }

        function triggerNotification(title, bodyText) {
            if (!notificationsEnabled) return;
            try {
                let ctx = new (window.AudioContext || window.webkitAudioContext)();
                let osc = ctx.createOscillator();
                let gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                osc.frequency.setValueAtTime(880, ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.4);
            } catch(e){}
            document.title = "🔔 NOVÁ OBJEDNÁVKA!";
            setTimeout(() => { document.title = "Logistik - Systém Závozů"; }, 5000);
        }

        function toggleSingleMode(enable) {
            singleModeLines[curLine] = enable;
            if (enable) {
                twoVariantModeLines[curLine] = false;
                if (!singleModeCar[curLine]) singleModeCar[curLine] = 'Tiguan';
            } else {
                singleModeLines[curLine] = false;
            }
            save();
            updateDynamicTheme();
            render();
        }

        function toggleTwoVariantMode(enable) {
            twoVariantModeLines[curLine] = enable;
            if (enable) {
                singleModeLines[curLine] = false;
                if (!twoVariantPair[curLine]) twoVariantPair[curLine] = 'Tiguan / Kodiaq';
            } else {
                twoVariantModeLines[curLine] = false;
            }
            save();
            updateDynamicTheme();
            render();
        }

        function setSingleCar(car, el) {
            singleModeCar[curLine] = car;
            save();
            updateDynamicTheme();
        }

        function setTwoPair(pair, el) {
            twoVariantPair[curLine] = pair;
            save();
            updateDynamicTheme();
        }

        function updateDynamicTheme() {
            let activeClass = curLine === 1 ? 'selected-1' : 'selected-2';
            let panelClass = curLine === 1 ? 'single-mode-panel line-1' : 'single-mode-panel line-2';
            let selectorBoxClass = curLine === 1 ? 'mode-selector-box line-1 active' : 'mode-selector-box line-2 active';
            let customBoxClass = curLine === 1 ? 'custom-stojan-input line-1 active' : 'custom-stojan-input line-2 active';

            document.getElementById('singleModePanel').className = panelClass;
            document.getElementById('twoVariantPanel').className = panelClass;
            document.getElementById('singleModeSelectBox').className = selectorBoxClass;
            document.getElementById('twoModeSelectBox').className = selectorBoxClass;
            
            let isSingleActive = singleModeLines[curLine];
            document.getElementById('btnSingleYes').className = 'btn-yn ' + (isSingleActive ? 'active-yes' : '');
            document.getElementById('btnSingleNo').className = 'btn-yn ' + (!isSingleActive ? 'active-no' : '');

            let isTwoActive = twoVariantModeLines[curLine];
            document.getElementById('btnTwoYes').className = 'btn-yn ' + (isTwoActive ? 'active-yes' : '');
            document.getElementById('btnTwoNo').className = 'btn-yn ' + (!isTwoActive ? 'active-no' : '');

            let singleSelectBox = document.getElementById('singleModeSelectBox');
            let twoSelectBox = document.getElementById('twoModeSelectBox');
            let standardSection = document.getElementById('standardOrderSection');

            if (isSingleActive) {
                singleSelectBox.style.display = 'block';
                twoSelectBox.style.display = 'none';
                standardSection.style.display = 'none';
            } else if (isTwoActive) {
                singleSelectBox.style.display = 'none';
                twoSelectBox.style.display = 'block';
                standardSection.style.display = 'none';
            } else {
                singleSelectBox.style.display = 'none';
                twoSelectBox.style.display = 'none';
                standardSection.style.display = 'block';
            }

            let currentSingleCar = singleModeCar[curLine] || 'Tiguan';
            let singleCarGrid = document.getElementById('singleCarGrid');
            let cars = ['Tiguan', 'Kodiaq', 'Tayron', 'Audi', 'Seat'];
            singleCarGrid.innerHTML = cars.map(c => `
                <div class="btn-opt ${currentSingleCar === c ? activeClass : ''}" onclick="setSingleCar('${c}', this)">${c}</div>
            `).join('');

            let currentPair = twoVariantPair[curLine] || 'Tiguan / Kodiaq';
            let twoPairGrid = document.getElementById('twoPairGrid');
            let pairs = ['Tiguan / Kodiaq', 'Audi / Seat'];
            twoPairGrid.innerHTML = pairs.map(p => `
                <div class="btn-opt ${currentPair === p ? activeClass : ''}" onclick="setTwoPair('${p}', this)">${p}</div>
            `).join('');

            let carGrid = document.getElementById('carGrid');
            document.querySelectorAll('#carGrid .btn-opt').forEach(b => {
                b.classList.remove('selected-1', 'selected-2');
                if (b.innerText === curCar) b.classList.add(activeClass);
            });

            document.querySelectorAll('#opt3WRT, #opt6WRT, #optCustomWRT').forEach(b => b.classList.remove('selected-1', 'selected-2'));
            
            if (curStojany === 3) {
                document.getElementById('opt3WRT').classList.add(activeClass);
            } else if (curStojany === 6) {
                document.getElementById('opt6WRT').classList.add(activeClass);
            } else {
                document.getElementById('optCustomWRT').classList.add(activeClass);
                document.getElementById('customStojanBox').className = customBoxClass;
            }
        }

        function setLine(l) {
            curLine = l;
            document.getElementById('lBtn1').className = 'line-btn ' + (l===1?'active-1':'');
            document.getElementById('lBtn2').className = 'line-btn ' + (l===2?'active-2':'');
            updateDynamicTheme();
        }

        function setCar(c, el) {
            curCar = c;
            updateDynamicTheme();
        }

        function setStojany(s, el) {
            curStojany = s;
            document.getElementById('customStojanBox').classList.remove('active');
            updateDynamicTheme();
            updateCalculations();
        }

        function enableCustomStojany(el) {
            document.getElementById('customStojanBox').classList.add('active');
            curStojany = parseInt(document.getElementById('customInput').value) || 1;
            updateDynamicTheme();
            updateCalculations();
        }

        function onCustomStojanyInput(val) {
            curStojany = parseInt(val) || 0;
            updateCalculations();
        }

        function updateCalculations() {
            let ks = curStojany * 12;
            let ob = Math.ceil(ks / 9);
            document.getElementById('lblKs').innerText = ks + ' ks';
            document.getElementById('lblOb').innerText = ob + ' obaly';
        }

        function addOrder() {
            let ks = curStojany * 12;
            let ob = Math.ceil(ks / 9);
            let note = document.getElementById('noteInput').value.trim();
            
            orders.push({ 
                id: Date.now(), line: curLine, car: curCar, 
                stojany: curStojany, total: ob, done: 0, note: note 
            });

            document.getElementById('noteInput').value = '';
            lastOrderCount = orders.length;
            save();
        }

        function cancelOrder(id) {
            orders = orders.filter(x => x.id !== id);
            lastOrderCount = orders.length;
            save();
        }

        function editOrderProgress(id) {
            let o = orders.find(x => x.id === id);
            if (!o) return;
            
            let promptText = "Srovnání obalů. Zadejte počet pro VZV.\n\n" +
                             "Info/TV: Ready - Připravený obal\n" +
                             "Ready - Plní se : 2 obaly\n" +
                             "Plná - Plní se : 3 obaly\n\n" +
                             "Vždy před zadáním se ujistěte zda počet sedí !\n\n" +
                             "Kalibrace / Úprava stavu obalů pro " + o.car + " (Celkem: " + o.total + " obalů):\n" +
                             "Zadejte aktuální počet zavezených obalů (0 až " + o.total + "):";

            let input = prompt(promptText, o.done);
            if (input === null) return;
            
            let newVal = parseInt(input);
            if (isNaN(newVal) || newVal < 0) {
                alert("Zadejte platné číslo od 0 do " + o.total);
                return;
            }
            
            if (newVal > o.total) newVal = o.total;
            
            o.done = newVal;
            o.note = (o.note ? o.note + " | " : "") + `Kalibrace (Ručně upraveno na ${newVal}/${o.total} obalů)`;
            
            if (o.done >= o.total) {
                orders = orders.filter(x => x.id !== id);
            }
            
            lastOrderCount = orders.length;
            save();
        }

        function sendCustomStockAlert() {
            let variant = document.getElementById('vzvVariantSelect').value;
            let count = document.getElementById('vzvCountInput').value;
            if (!count) {
                alert("Prosím zadejte počet obalů.");
                return;
            }
            stockAlerts.push({ id: Date.now(), variant: variant, count: count });
            document.getElementById('vzvCountInput').value = '';
            save();
        }

        function dismissAlert(alertId) {
            stockAlerts = stockAlerts.filter(a => a.id !== alertId);
            save();
        }

        function zavezt(id) {
            let o = orders.find(x => x.id === id);
            if (o) {
                o.done++;
                if (o.done >= o.total) {
                    orders = orders.filter(x => x.id !== id);
                    lastOrderCount = orders.length;
                }
                save();
            }
        }

        function render() {
            if (sessionStorage.getItem('device_authenticated') !== 'true') return;

            renderRepeatBoxesUI();

            // Zobrazení VZV výstrahy pro chybějící bedny na čidlech
            let vzvSensorAlertArea = document.getElementById('vzvSensorAlertArea');
            if (vzvSensorAlertArea) {
                let activeSensors = [];
                for (let i = 1; i <= 4; i++) {
                    if (repeatBoxes[i]) activeSensors.push(i);
                }
                if (activeSensors.length > 0) {
                    vzvSensorAlertArea.innerHTML = `
                        <div class="vzv-sensor-alert">
                            <div class="vzv-sensor-title">⚠️ Opakuj zavezení, bedna není na čidle!</div>
                            <div style="font-size:0.8rem; font-weight:bold; color:#f8fafc; margin-bottom:6px;">Týká se boxů: ${activeSensors.join(', ')}</div>
                            <button class="btn-resolve-sensor" onclick="clearAllRepeatBoxes()">✓ OK / VYŘEŠENO</button>
                        </div>
                    `;
                } else {
                    vzvSensorAlertArea.innerHTML = '';
                }
            }

            let alertArea = document.getElementById('alertAreaA');
            if (alertArea) {
                alertArea.innerHTML = '';
                stockAlerts.forEach(a => {
                    alertArea.innerHTML += `
                        <div class="stock-alert-box">
                            <span>⚠️ <b>VZV hlásí:</b> Pro variantu <b>${a.variant}</b> zbývá posledních <b>${a.count} obalů</b>!</span>
                            <button class="btn-dismiss" onclick="dismissAlert(${a.id})">✕ Rozumím</button>
                        </div>
                    `;
                });
            }

            let listA = document.getElementById('listA');
            if (listA) {
                let htmlContent = '';

                [1, 2].forEach(l => {
                    let badgeCls = l === 1 ? 'wrt-badge-1' : 'wrt-badge-2';
                    if (singleModeLines[l]) {
                        let cCar = singleModeCar[l] || 'Tiguan';
                        htmlContent += `
                            <div style="background:#1e293b; padding:10px; border-radius:6px; margin-bottom:6px; border:1px solid #f59e0b; display:flex; justify-content:space-between; align-items:center;">
                                <span>🔒 <b>Režim 1 varianta:</b> ${cCar} <span class="${badgeCls}">Linka ${l}</span></span>
                                <span style="font-size:0.75rem; color:#f59e0b; font-weight:bold;">Aktivní</span>
                            </div>
                        `;
                    }
                    if (twoVariantModeLines[l]) {
                        let cPair = twoVariantPair[l] || 'Tiguan / Kodiaq';
                        htmlContent += `
                            <div style="background:#1e293b; padding:10px; border-radius:6px; margin-bottom:6px; border:1px solid #f59e0b; display:flex; justify-content:space-between; align-items:center;">
                                <span>🔒 <b>Režim 2 varianty:</b> ${cPair} <span class="${badgeCls}">Linka ${l}</span></span>
                                <span style="font-size:0.75rem; color:#f59e0b; font-weight:bold;">Aktivní</span>
                            </div>
                        `;
                    }
                });

                if (orders.length === 0 && !singleModeLines[1] && !singleModeLines[2] && !twoVariantModeLines[1] && !twoVariantModeLines[2]) {
                    htmlContent += '<div class="empty">Žádné aktivní objednávky</div>';
                }

                orders.forEach(o => {
                    let lineClass = o.line === 1 ? 'line-1' : 'line-2';
                    let noteHtml = o.note ? `<div class="note-tag ${lineClass}">📝 ${o.note}</div>` : '';
                    let remainingWRT = Math.max(0, o.stojany - o.done);
                    let wrtBadgeClass = o.line === 1 ? 'wrt-badge-1' : 'wrt-badge-2';

                    htmlContent += `<div style="background:#1e293b; padding:8px 10px; border-radius:6px; margin-bottom:6px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span style="flex-grow:1;"><b>${o.car}</b> <span class="${wrtBadgeClass}">Zbývá ${remainingWRT}/${o.stojany} WRT</span> - Linka ${o.line}</span>
                            <span onclick="editOrderProgress(${o.id})" class="editable-progress" title="Kliknutím upravit/zkalibrovat stav obalů">📦 ${o.done}/${o.total} obalů</span>
                            <button class="btn-delete" onclick="cancelOrder(${o.id})" title="Zrušit">✖</button>
                        </div>
                        ${noteHtml}
                    </div>`;
                });

                listA.innerHTML = htmlContent;
            }

            [1, 2].forEach(l => {
                let lOrders = orders.filter(x => x.line === l);
                let title = document.getElementById(`l${l}Title`);
                let next = document.getElementById(`l${l}Next`);
                let body = document.getElementById(`l${l}Body`);
                let isSingle = singleModeLines[l];
                let isTwo = twoVariantModeLines[l];
                let currentSingleCar = singleModeCar[l] || 'Tiguan';
                let currentPair = twoVariantPair[l] || 'Tiguan / Kodiaq';

                if (title && next && body) {
                    if (lOrders.length === 0 && !isSingle && !isTwo) {
                        title.innerText = 'Žádná objednávka';
                        next.className = 'next-txt none';
                        next.innerText = 'Následuje ➔ Žádné';
                        body.innerHTML = '<div class="empty">Linka je volná</div>';
                    } else {
                        if (isSingle || isTwo) {
                            title.innerText = isSingle ? `🔒 Režim 1 varianta: ${currentSingleCar}` : `🔒 Režim 2 varianty: ${currentPair}`;
                            next.className = 'next-txt none';
                            next.innerText = 'Následuje ➔ Žádné';
                        } else {
                            let cur = lOrders[0];
                            let nxt1 = lOrders[1];
                            let nxt2 = lOrders[2];
                            
                            title.innerText = `${cur.car} (${cur.stojany} WRT)`;
                            
                            if (nxt1) {
                                next.className = 'next-txt';
                                let queueText = `Následuje ➔ <b>${nxt1.car}</b> (${nxt1.total} ob.)`;
                                if (nxt2) queueText += ` ➔ <b>${nxt2.car}</b> (${nxt2.total} ob.)`;
                                next.innerHTML = queueText;
                            } else {
                                next.className = 'next-txt none';
                                next.innerText = 'Následuje ➔ Žádné';
                            }
                        }

                        let modeAlertHtml = '';
                        if (isSingle) {
                            modeAlertHtml = `<div class="vzv-single-mode-box">⚠️ ZAVÁŽET POUZE: ${currentSingleCar.toUpperCase()}.<br>POKUD BY BYLA ZMĚNA, VČAS SE ZMĚNÍ OBJEDNÁVKA!</div>`;
                        } else if (isTwo) {
                            modeAlertHtml = `<div class="vzv-single-mode-box">⚠️ ${currentPair} výroba 2 produktů se stejným obalem.<br>POKUD BY BYLA ZMĚNA, VČAS SE ZMĚNÍ OBJEDNÁVKA!</div>`;
                        }

                        if (isSingle || isTwo) {
                            body.innerHTML = modeAlertHtml + '<div class="empty" style="color:#fbbf24; font-weight:bold;">Režim je aktivní na lince</div>';
                        } else if (lOrders.length === 0) {
                            body.innerHTML = modeAlertHtml + '<div class="empty">Čeká se na zadání objednávky</div>';
                        } else {
                            let cur = lOrders[0];
                            let boxes = '';
                            for (let i = 1; i <= cur.total; i++) {
                                let st = i <= cur.done ? 'done' : 'pending';
                                boxes += `<div class="box-unit ${st}">#${i}</div>`;
                            }

                            let btnText = l === 1 ? '✓ ZAVEZT OBAL DO OTEVŘENÉHO BOXU 3 - 4' : '✓ ZAVEZT OBAL DO OTEVŘENÉHO BOXU 1 - 2';
                            let lineClass = cur.line === 1 ? 'line-1' : 'line-2';
                            let noteHtml = cur.note ? `<div class="note-tag ${lineClass}">📝 Poznámka: ${cur.note}</div>` : '';

                            body.innerHTML = `
                                ${modeAlertHtml}
                                ${noteHtml}
                                <div style="display:flex; justify-content:space-between; font-size:0.75rem; margin-bottom:4px; color:#94a3b8;">
                                    <span>Zbývá zavezt: <b>${cur.total - cur.done} ob.</b></span>
                                </div>
                                <div class="boxes-row">${boxes}</div>
                                <button class="btn-zavez" onclick="zavezt(${cur.id})">${btnText}</button>
                            `;
                        }
                    }
                }
            });

            let doneBanner = document.getElementById('doneBanner');
            if (doneBanner) {
                doneBanner.style.display = (orders.length === 0 && !singleModeLines[1] && !singleModeLines[2] && !twoVariantModeLines[1] && !twoVariantModeLines[2]) ? 'block' : 'none';
            }
        }

        function clearAllRepeatBoxes() {
            repeatBoxes = { 1: false, 2: false, 3: false, 4: false };
            save();
            render();
        }
    </script>

</body>
</html>
