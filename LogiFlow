<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Logistik - Systém Závozů</title>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
        body { background: #0f172a; color: #f8fafc; padding: 10px; font-size: 14px; }
        
        #loginScreen {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            min-height: 80vh; text-align: center; padding: 20px;
        }
        .login-box {
            background: #1e293b; border: 1px solid #334155; padding: 24px;
            border-radius: 12px; width: 100%; max-width: 340px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        .login-title { font-size: 1.4rem; font-weight: bold; color: #f59e0b; margin-bottom: 6px; }
        .login-sub { font-size: 0.8rem; color: #94a3b8; margin-bottom: 20px; }
        .login-input {
            width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155;
            border-radius: 8px; color: #fff; font-size: 1.2rem; text-align: center;
            letter-spacing: 4px; margin-bottom: 12px; outline: none;
        }
        .login-input:focus { border-color: #f59e0b; }
        .btn-login {
            width: 100%; padding: 12px; background: #f59e0b; color: #0f172a;
            border: none; border-radius: 8px; font-size: 1rem; font-weight: bold; cursor: pointer;
        }
        .login-error { color: #ef4444; font-size: 0.8rem; margin-top: 10px; display: none; }

        #appScreen { display: none; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .logo { font-size: 1.1rem; font-weight: bold; color: #f59e0b; }
        .nav-btns { display: flex; gap: 4px; background: #1e293b; padding: 4px; border-radius: 8px; align-items: center; }
        .nav-btn { background: transparent; border: none; color: #94a3b8; padding: 6px 10px; font-weight: bold; border-radius: 6px; cursor: pointer; }
        .nav-btn.active { background: #f59e0b; color: #0f172a; }
        .btn-logout { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid #ef4444; padding: 5px 8px; font-size: 0.75rem; border-radius: 6px; margin-left: 4px; cursor: pointer; font-weight: bold; }

        .line-select { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
        .line-btn { padding: 10px; background: #1e293b; border: 2px solid #334155; color: #94a3b8; font-weight: bold; text-align: center; border-radius: 8px; cursor: pointer; }
        .line-btn.active-1 { border-color: #3b82f6; color: #fff; background: #1e3a8a; }
        .line-btn.active-2 { border-color: #a855f7; color: #fff; background: #581c87; }

        .lbl { font-size: 0.75rem; text-transform: uppercase; color: #94a3b8; font-weight: bold; margin: 8px 0 4px 0; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 8px; }
        .btn-opt { background: #1e293b; border: 1px solid #334155; color: #fff; padding: 10px 4px; border-radius: 8px; font-weight: bold; text-align: center; cursor: pointer; font-size: 0.85rem; }
        .btn-opt.selected { border-color: #f59e0b; background: rgba(245, 158, 11, 0.2); color: #f59e0b; }

        .custom-stojan-input { margin-top: 6px; display: none; gap: 6px; align-items: center; }
        .custom-stojan-input.active { display: flex; }
        .custom-stojan-input input { background: #1e293b; border: 1px solid #f59e0b; color: #fff; padding: 8px; border-radius: 6px; font-size: 0.9rem; width: 100%; font-weight: bold; }

        .note-input { width: 100%; background: #1e293b; border: 1px solid #334155; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; outline: none; }
        .note-input:focus { border-color: #f59e0b; }

        .box-info { background: #1e293b; border: 1px dashed #334155; border-radius: 8px; padding: 8px; display: flex; justify-content: space-around; text-align: center; margin-bottom: 12px; }
        .val { font-size: 1.1rem; font-weight: bold; color: #f59e0b; }
        .btn-submit { width: 100%; padding: 12px; background: #f59e0b; color: #0f172a; border: none; border-radius: 8px; font-size: 1rem; font-weight: bold; cursor: pointer; }

        .vzv-card { background: #1e293b; border-radius: 8px; padding: 10px; margin-bottom: 10px; border-top: 4px solid #3b82f6; }
        .vzv-card.l2 { border-top-color: #a855f7; }
        .vzv-hdr { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
        .badge { font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; color: #fff; font-weight: bold; background: #3b82f6; }
        .badge.l2 { background: #a855f7; }
        .next-txt { font-size: 0.8rem; color: #f59e0b; font-weight: bold; margin-top: 2px; line-height: 1.3; }
        .next-txt.none { color: #64748b; font-weight: normal; }
        
        .boxes-row { display: flex; gap: 4px; margin: 8px 0; flex-wrap: wrap; }
        .box-unit { flex: 1; min-width: 30px; height: 26px; background: #0f172a; border: 1px solid #334155; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: #64748b; font-weight: bold; }
        .box-unit.done { background: #065f46; color: #34d399; border-color: #059669; }
        .box-unit.active { background: #78350f; color: #fbbf24; border-color: #d97706; }
        .btn-zavez { width: 100%; padding: 10px; background: #10b981; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }

        .permanent-banner {
            background: #1e293b; border: 1px solid #334155; border-radius: 8px;
            padding: 8px 10px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px;
        }
        .banner-txt { font-size: 0.8rem; color: #94a3b8; font-weight: bold; display: flex; align-items: center; gap: 4px; }
        .banner-btns { display: flex; gap: 4px; background: #0f172a; padding: 3px; border-radius: 6px; }
        .btn-yn { padding: 5px 12px; border-radius: 4px; font-weight: bold; font-size: 0.75rem; border: none; cursor: pointer; color: #64748b; background: transparent; }
        .btn-yn.active-yes { background: #10b981; color: #fff; }
        .btn-yn.active-no { background: #ef4444; color: #fff; }

        .vzv-alert-panel { background: #1e293b; border: 1px solid #ef4444; border-radius: 8px; padding: 10px; margin-top: 16px; }
        .vzv-alert-title { font-size: 0.8rem; font-weight: bold; color: #ef4444; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; gap: 4px; }
        .vzv-alert-row { display: flex; gap: 6px; margin-bottom: 8px; }
        .vzv-select { flex: 1; background: #0f172a; border: 1px solid #334155; color: #fff; padding: 8px; border-radius: 6px; font-size: 0.85rem; font-weight: bold; outline: none; }
        .vzv-num-input { width: 70px; background: #0f172a; border: 1px solid #334155; color: #fff; padding: 8px; border-radius: 6px; font-size: 0.85rem; text-align: center; font-weight: bold; outline: none; }
        .btn-send-alert { width: 100%; padding: 9px; background: #ef4444; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.85rem; }

        .empty { text-align: center; color: #64748b; padding: 12px; font-size: 0.85rem; }
        .done-msg { background: #065f46; color: #34d399; padding: 10px; border-radius: 8px; text-align: center; font-weight: bold; margin-top: 10px; }
        .note-tag { background: rgba(245, 158, 11, 0.15); border-left: 3px solid #f59e0b; padding: 4px 8px; font-size: 0.75rem; color: #fbbf24; margin: 4px 0 8px 0; border-radius: 0 4px 4px 0; }
        .btn-delete { background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; color: #ef4444; width: 26px; height: 26px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.85rem; cursor: pointer; margin-left: 8px; flex-shrink: 0; }
    </style>
</head>
<body>

    <div id="loginScreen">
        <div class="login-box">
            <div class="login-title">⚡ LogiFlow</div>
            <div class="login-sub">Zadejte přístupové heslo zařízení</div>
            <input type="password" id="passInput" class="login-input" placeholder="••••" autofocus onkeydown="if(event.key==='Enter') checkPassword()">
            <button class="btn-login" type="button" onclick="checkPassword()">VSTOUPIT DO SYSTÉMU</button>
            <div id="loginError" class="login-error">⚠️ Nesprávné heslo! Zkuste to znovu.</div>
        </div>
    </div>

    <div id="appScreen">
        <div class="header">
            <div class="logo">⚡ LogiFlow</div>
            <div class="nav-btns">
                <button class="nav-btn active" id="tabA" onclick="showTab('A')">Obsluha A</button>
                <button class="nav-btn" id="tabB" onclick="showTab('B')">VZV B</button>
                <button class="btn-logout" onclick="logout()" title="Odhlásit tento telefon">🔓</button>
            </div>
        </div>

        <div class="permanent-banner">
            <div class="banner-txt">🔔 Zvukové upozornění a notifikace</div>
            <div class="banner-btns">
                <button class="btn-yn active-yes" id="btnNotifYes" onclick="toggleNotifications(true)">ANO</button>
                <button class="btn-yn" id="btnNotifNo" onclick="toggleNotifications(false)">NE</button>
            </div>
        </div>

        <div id="viewA">
            <div id="alertAreaA"></div>
            <div class="lbl">Vyberte Linku</div>
            <div class="line-select">
                <div class="line-btn active-1" id="lBtn1" onclick="setLine(1)">LINKA 1</div>
                <div class="line-btn" id="lBtn2" onclick="setLine(2)">LINKA 2</div>
            </div>

            <div class="lbl">Produkt</div>
            <div class="grid-3">
                <div class="btn-opt selected" onclick="setCar('Tiguan', this)">Tiguan</div>
                <div class="btn-opt" onclick="setCar('Kodiaq', this)">Kodiaq</div>
                <div class="btn-opt" onclick="setCar('Tayron', this)">Tayron</div>
                <div class="btn-opt" onclick="setCar('Audi', this)">Audi</div>
                <div class="btn-opt" onclick="setCar('Seat', this)">Seat</div>
            </div>

            <div class="lbl">Počet Stojanů WRT</div>
            <div class="grid-3">
                <div class="btn-opt selected" id="opt3WRT" onclick="setStojany(3, this)">3 WRT</div>
                <div class="btn-opt" id="opt6WRT" onclick="setStojany(6, this)">6 WRT</div>
                <div class="btn-opt" id="optCustomWRT" onclick="enableCustomStojany(this)">✏️ Vlastní</div>
            </div>

            <div class="custom-stojan-input" id="customStojanBox">
                <span style="font-size:0.8rem; color:#94a3b8; white-space:nowrap;">Zadejte počet:</span>
                <input type="number" id="customInput" min="1" max="50" value="4" oninput="onCustomStojanyInput(this.value)">
            </div>

            <div class="lbl">Poznámka pro VZV (volitelné)</div>
            <input type="text" id="noteInput" class="note-input" placeholder="Napište poznámku k objednávce..." />

            <div class="box-info">
                <div><div class="val" id="lblKs">36 ks</div><div style="font-size:0.65rem; color:#94a3b8;">CELKEM</div></div>
                <div><div class="val" id="lblOb">4 obaly</div><div style="font-size:0.65rem; color:#94a3b8;">K ZAVÁŽENÍ (po 9ks)</div></div>
            </div>

            <button class="btn-submit" onclick="addOrder()">POSLAT OBJEDNÁVKU VZV</button>
            <div class="lbl" style="margin-top:16px;">Odesláno na VZV (Probíhá)</div>
            <div id="listA"></div>
        </div>

        <div id="viewB" style="display:none;">
            <div class="lbl">Přehled linek</div>
            <div class="vzv-card">
                <div class="vzv-hdr">
                    <div>
                        <span class="badge">Linka 1 - Box: 3 - 4</span>
                        <h2 id="l1Title" style="font-size:1.1rem; margin-top:2px;">-</h2>
                        <div id="l1Next" class="next-txt none">Následuje ➔ Žádné</div>
                    </div>
                </div>
                <div id="l1Body"></div>
            </div>

            <div class="vzv-card l2">
                <div class="vzv-hdr">
                    <div>
                        <span class="badge l2">Linka 2 - Box: 1 - 2</span>
                        <h2 id="l2Title" style="font-size:1.1rem; margin-top:2px;">-</h2>
                        <div id="l2Next" class="next-txt none">Následuje ➔ Žádné</div>
                    </div>
                </div>
                <div id="l2Body"></div>
            </div>

            <div class="vzv-alert-panel">
                <div class="vzv-alert-title">⚠️ Hlášení stavu obalů obsluze A</div>
                <div class="vzv-alert-row">
                    <select id="vzvVariantSelect" class="vzv-select">
                        <option value="Tiguan / Kodiaq">Tiguan / Kodiaq</option>
                        <option value="Audi / Seat">Audi / Seat</option>
                        <option value="Tayron">Tayron</option>
                    </select>
                    <input type="number" id="vzvCountInput" class="vzv-num-input" placeholder="Počet" value="5" min="1" max="99">
                </div>
                <button class="btn-send-alert" onclick="sendCustomStockAlert()">📢 ODESLAT HLÁŠENÍ OBSLUZE A</button>
            </div>

            <div id="doneBanner" class="done-msg" style="display:none;">
                ✓ Vše zpracováno! Čekám na novou objednávku.
            </div>
        </div>
    </div>

    <script>
        // FIREBASE PROPOJENÍ MEZI TELEFONY
        const firebaseConfig = {
            databaseURL: "https://logiflow-default-rtdb.europe-west1.firebasedatabase.app"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        const SYSTEM_PASSWORD = '1234';
        let notificationsEnabled = true;
        let curLine = 1, curCar = 'Tiguan', curStojany = 3;
        let orders = [];
        let stockAlerts = [];
        let lastOrderCount = 0;

        // Reálná synchronizace dat přes Firebase
        db.ref('orders').on('value', (snapshot) => {
            let updatedOrders = snapshot.val() || [];
            if (updatedOrders.length > lastOrderCount) {
                let newest = updatedOrders[updatedOrders.length - 1];
                triggerNotification("⚡ Nová objednávka na VZV!", `${newest.car} (${newest.stojany} WRT) - Linka ${newest.line}`);
            }
            orders = updatedOrders;
            lastOrderCount = orders.length;
            render();
        });

        db.ref('alerts').on('value', (snapshot) => {
            stockAlerts = snapshot.val() || [];
            render();
        });

        function save() {
            db.ref('orders').set(orders);
            db.ref('alerts').set(stockAlerts);
        }

        function checkPassword() {
            const input = document.getElementById('passInput').value;
            if (input === SYSTEM_PASSWORD) {
                sessionStorage.setItem('device_authenticated', 'true');
                document.getElementById('loginError').style.display = 'none';
                showApp();
            } else {
                document.getElementById('loginError').style.display = 'block';
            }
        }

        function logout() {
            sessionStorage.removeItem('device_authenticated');
            document.getElementById('passInput').value = '';
            document.getElementById('loginError').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'flex';
            document.getElementById('appScreen').style.display = 'none';
        }

        function showApp() {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('appScreen').style.display = 'block';
            render();
        }

        if (sessionStorage.getItem('device_authenticated') === 'true') {
            showApp();
        }

        function toggleNotifications(enable) {
            notificationsEnabled = enable;
            const btnYes = document.getElementById('btnNotifYes');
            const btnNo = document.getElementById('btnNotifNo');
            if (enable) {
                btnYes.className = 'btn-yn active-yes';
                btnNo.className = 'btn-yn';
            } else {
                btnYes.className = 'btn-yn';
                btnNo.className = 'btn-yn active-no';
            }
        }

        function triggerNotification(title, bodyText) {
            if (!notificationsEnabled) return;
            try {
                let ctx = new (window.AudioContext || window.webkitAudioContext)();
                let osc = ctx.createOscillator();
                let gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                osc.frequency.setValueAtTime(880, ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.4);
            } catch(e){}
            document.title = "🔔 NOVÁ OBJEDNÁVKA!";
            setTimeout(() => { document.title = "Logistik - Systém Závozů"; }, 5000);
        }

        function showTab(t) {
            document.getElementById('viewA').style.display = t==='A'?'block':'none';
            document.getElementById('viewB').style.display = t==='B'?'block':'none';
            document.getElementById('tabA').className = 'nav-btn ' + (t==='A'?'active':'');
            document.getElementById('tabB').className = 'nav-btn ' + (t==='B'?'active':'');
        }

        function setLine(l) {
            curLine = l;
            document.getElementById('lBtn1').className = 'line-btn ' + (l===1?'active-1':'');
            document.getElementById('lBtn2').className = 'line-btn ' + (l===2?'active-2':'');
        }

        function setCar(c, el) {
            curCar = c;
            document.querySelectorAll('.grid-3 .btn-opt').forEach(b => b.classList.remove('selected'));
            el.classList.add('selected');
        }

        function setStojany(s, el) {
            curStojany = s;
            document.getElementById('customStojanBox').classList.remove('active');
            document.querySelectorAll('#opt3WRT, #opt6WRT, #optCustomWRT').forEach(b => b.classList.remove('selected'));
            el.classList.add('selected');
            updateCalculations();
        }

        function enableCustomStojany(el) {
            document.querySelectorAll('#opt3WRT, #opt6WRT, #optCustomWRT').forEach(b => b.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('customStojanBox').classList.add('active');
            curStojany = parseInt(document.getElementById('customInput').value) || 1;
            updateCalculations();
        }

        function onCustomStojanyInput(val) {
            curStojany = parseInt(val) || 0;
            updateCalculations();
        }

        function updateCalculations() {
            let ks = curStojany * 12;
            let ob = Math.ceil(ks / 9);
            document.getElementById('lblKs').innerText = ks + ' ks';
            document.getElementById('lblOb').innerText = ob + ' obaly';
        }

        function addOrder() {
            let ks = curStojany * 12;
            let ob = Math.ceil(ks / 9);
            let note = document.getElementById('noteInput').value.trim();

            orders.push({ 
                id: Date.now(), line: curLine, car: curCar, 
                stojany: curStojany, total: ob, done: 0, note: note 
            });

            document.getElementById('noteInput').value = '';
            lastOrderCount = orders.length;
            save();
        }

        function cancelOrder(id) {
            orders = orders.filter(x => x.id !== id);
            lastOrderCount = orders.length;
            save();
        }

        function sendCustomStockAlert() {
            let variant = document.getElementById('vzvVariantSelect').value;
            let count = document.getElementById('vzvCountInput').value || '5';
            stockAlerts.push({ id: Date.now(), variant: variant, count: count });
            save();
        }

        function dismissAlert(alertId) {
            stockAlerts = stockAlerts.filter(a => a.id !== alertId);
            save();
        }

        function zavezt(id) {
            let o = orders.find(x => x.id === id);
            if (o) {
                o.done++;
                if (o.done >= o.total) {
                    orders = orders.filter(x => x.id !== id);
                    lastOrderCount = orders.length;
                }
                save();
            }
        }

        function render() {
            if (sessionStorage.getItem('device_authenticated') !== 'true') return;

            let alertArea = document.getElementById('alertAreaA');
            alertArea.innerHTML = '';
            stockAlerts.forEach(a => {
                alertArea.innerHTML += `
                    <div class="stock-alert-box">
                        <span>⚠️ <b>VZV hlásí:</b> Pro variantu <b>${a.variant}</b> zbývá posledních <b>${a.count} obalů</b>!</span>
                        <button class="btn-dismiss" onclick="dismissAlert(${a.id})">✕ Rozumím</button>
                    </div>
                `;
            });

            let listA = document.getElementById('listA');
            listA.innerHTML = orders.length === 0 ? '<div class="empty">Žádné aktivní objednávky</div>' : '';
            orders.forEach(o => {
                let noteHtml = o.note ? `<div class="note-tag">📝 ${o.note}</div>` : '';
                listA.innerHTML += `<div style="background:#1e293b; padding:8px 10px; border-radius:6px; margin-bottom:6px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="flex-grow:1;"><b>${o.car}</b> (${o.stojany} WRT) - Linka ${o.line}</span>
                        <span style="color:#f59e0b; font-weight:bold; white-space:nowrap; margin-left:8px;">${o.done}/${o.total} obalů</span>
                        <button class="btn-delete" onclick="cancelOrder(${o.id})" title="Zrušit">✖</button>
                    </div>
                    ${noteHtml}
                </div>`;
            });

            [1, 2].forEach(l => {
                let lOrders = orders.filter(x => x.line === l);
                let title = document.getElementById(`l${l}Title`);
                let next = document.getElementById(`l${l}Next`);
                let body = document.getElementById(`l${l}Body`);

                if (lOrders.length === 0) {
                    title.innerText = 'Žádná objednávka';
                    next.className = 'next-txt none';
                    next.innerText = 'Následuje ➔ Žádné';
                    body.innerHTML = '<div class="empty">Linka je volná</div>';
                } else {
                    let cur = lOrders[0];
                    let nxt1 = lOrders[1];
                    let nxt2 = lOrders[2];
                    
                    title.innerText = `${cur.car} (${cur.stojany} WRT)`;
                    
                    if (nxt1) {
                        next.className = 'next-txt';
                        let queueText = `Následuje ➔ <b>${nxt1.car}</b> (${nxt1.total} ob.)`;
                        if (nxt2) queueText += ` ➔ <b>${nxt2.car}</b> (${nxt2.total} ob.)`;
                        next.innerHTML = queueText;
                    } else {
                        next.className = 'next-txt none';
                        next.innerText = 'Následuje ➔ Žádné';
                    }

                    let boxes = '';
                    for (let i = 1; i <= cur.total; i++) {
                        let st = i <= cur.done ? 'done' : (i === cur.done + 1 ? 'active' : '');
                        boxes += `<div class="box-unit ${st}">#${i}</div>`;
                    }

                    let noteHtml = cur.note ? `<div class="note-tag">📝 Poznámka: ${cur.note}</div>` : '';
                    body.innerHTML = `
                        ${noteHtml}
                        <div style="display:flex; justify-content:space-between; font-size:0.75rem; margin-bottom:4px; color:#94a3b8;">
                            <span>Zbývá zavezt: <b>${cur.total - cur.done} ob.</b></span>
                        </div>
                        <div class="boxes-row">${boxes}</div>
                        <button class="btn-zavez" onclick="zavezt(${cur.id})">✓ ZAVEZT 1 OBAL (LINKA ${l})</button>
                    `;
                }
            });

            document.getElementById('doneBanner').style.display = orders.length === 0 ? 'block' : 'none';
        }
    </script>
</body>
</html>
    
